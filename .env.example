# define commands by prefixing the name with 'COMMAND_'
# '@' as first character stops make from echoing the command at start of output
COMMAND_docker_compose_build_nocache=${DOCKER_COMPOSE} build --no-cache
COMMAND_format_check_dockerfile=@${DOCKER_COMPOSE} --profile cli run --rm format check Dockerfile && echo 'OK - Dockerfile is properly formatted' # format check dockerfile
COMMAND_format_check_github_actions=@${DOCKER_COMPOSE} --profile cli run --rm format check .github/workflows/* && echo 'OK - github actions are properly formatted' # format check github actions
COMMAND_format_dockerfile=@${DOCKER_COMPOSE} --profile cli run --rm format fmt --diff Dockerfile && echo 'OK - Dockerfile is properly formatted' # format dockerfile
COMMAND_format_github_actions=@${DOCKER_COMPOSE} --profile cli run --rm format fmt --diff .github/workflows/* && echo 'OK - github actions are properly formatted' # format github actions
COMMAND_lint_dockerfile=@${DOCKER_COMPOSE} --profile cli run --rm lint-dockerfile hadolint Dockerfile && echo 'OK - Dockerfile linting success' # lint dockerfile
COMMAND_lint_github_actions=@${DOCKER_COMPOSE} --profile cli run --rm lint-github-actions .github/workflows/* && echo 'OK - github actions linting success' # lint github actions
COMMAND_shell=@${DOCKER_COMPOSE} run --entrypoint sh --rm app # run shell in the app container
COMMAND_shell_cron=@${DOCKER_COMPOSE} run --entrypoint sh --rm cron # run shell in the cron container
COMMAND_shell_format=@${DOCKER_COMPOSE} --profile cli run --entrypoint sh --rm format # run shell in the format container
COMMAND_shell_lint_dockerfile=@${DOCKER_COMPOSE} --profile cli run --entrypoint sh --rm lint-dockerfile # run shell in the lint-dockerfile container
COMMAND_shell_lint_github_actions=@${DOCKER_COMPOSE} --profile cli run --entrypoint sh --rm lint-github-actions # run shell in the lint-github-actions container
COMMAND_shell_proxy=@${DOCKER_COMPOSE} run --entrypoint sh --rm proxy # run shell in the proxy container
COMMAND_shell_exec=@${DOCKER_COMPOSE} exec app sh # run shell within running app container
COMMAND_shell_exec_cron=@${DOCKER_COMPOSE} exec cron sh # run shell within running cron container
COMMAND_shell_exec_proxy=@${DOCKER_COMPOSE} exec proxy sh # run shell within running proxy container

# override the docker compose command, eg docker-compose or podman-compose
#DOCKER_COMPOSE=docker compose
